# Runtime and request security
CAVEWORKERS_ENV=development
PORT=3000
ALLOWED_ORIGINS=https://caveworkers.ai.studio
COOKIE_SECURE=false
# Historical name retained for OAuth state signing; generate with Node.js.
FLASK_SECRET=
# Optional dedicated OAuth state secret; required in production if FLASK_SECRET is empty.
OAUTH_STATE_SECRET=
# Optional Sentry error observability. Keep SENTRY_DSN empty for local development.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# 0 disables performance traces; use a bounded production rate such as 0.1.
SENTRY_TRACES_SAMPLE_RATE=0

# Firebase browser configuration
FIREBASE_API_KEY=AIzaSyBXDF0iimw-zgwaxG5qJ9gngRKSJ_eLPt8
FIREBASE_APP_ID=1:980597206467:web:789036c39cfb0541d1a176
FIREBASE_AUTH_DOMAIN=caveworkers.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=980597206467
FIREBASE_STORAGE_BUCKET=caveworkers.firebasestorage.app

# Firebase Admin credentials: use a service-account path, the FIREBASE_* trio,
# or platform application-default credentials. Never commit private keys.
FIREBASE_PROJECT_ID=caveworkers
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=
GOOGLE_APPLICATION_CREDENTIALS=

# Analyst model providers
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANALYST_MODEL=qwen/qwen3-30b-a3b
OPENROUTER_TIMEOUT_MS=30000
ANALYST_MAX_TOKENS=900
GEMINI_API_KEY=
PUBLIC_APP_URL=https://caveworkers.ai.studio

# Tenant-scoped Google connector OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://caveworkers.ai.studio/api/google/oauth/callback
# Generate a separate high-entropy value for encrypted connector tokens.
MCP_TOKEN_ENCRYPTION_KEY=

# Razorpay billing and webhook verification
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Always-on workforce worker
ALWAYS_ON_WORKER_ENABLED=true
WORKER_POLL_MS=1500
WORKER_INSTANCE_ID=

# Optional bounded, retrieval-only web research
WEB_RESEARCH_ENABLED=false
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
