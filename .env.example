# Runtime and request security
CAVEWORKERS_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
# Historical name retained for OAuth state signing; generate with Node.js.
FLASK_SECRET=
# Optional Sentry error observability. Keep SENTRY_DSN empty for local development.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# 0 disables performance traces; use a bounded production rate such as 0.1.
SENTRY_TRACES_SAMPLE_RATE=0

# Firebase browser configuration
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=

# Firebase Admin credentials: use a service-account path, the FIREBASE_* trio,
# or platform application-default credentials. Never commit private keys.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=
GOOGLE_APPLICATION_CREDENTIALS=

# Analyst model providers
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANALYST_MODEL=qwen/qwen3-30b-a3b
OPENROUTER_TIMEOUT_MS=30000
ANALYST_MAX_TOKENS=900
GEMINI_API_KEY=
PUBLIC_APP_URL=http://localhost:3000

# Tenant-scoped Google connector OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Generate a separate high-entropy value for encrypted connector tokens.
MCP_TOKEN_ENCRYPTION_KEY=

# Razorpay billing and webhook verification
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Always-on workforce worker
ALWAYS_ON_WORKER_ENABLED=true
WORKER_POLL_MS=1500
WORKER_INSTANCE_ID=

# Optional bounded, retrieval-only web research
WEB_RESEARCH_ENABLED=false
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
