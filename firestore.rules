rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userCompanyId() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.company_id
        : null;
    }

    function sameCompany(companyId) {
      return signedIn() && (userCompanyId() == companyId || companyOwner(companyId));
    }

    function companyOwner(companyId) {
      return signedIn() && exists(/databases/$(database)/documents/companies/$(companyId))
        && get(/databases/$(database)/documents/companies/$(companyId)).data.owner_uid == request.auth.uid;
    }

    // User profiles are readable and writable by the authenticated user.
    match /users/{uid} {
      allow read, create, update: if ownUser(uid);
      allow delete: if false;
    }

    // Company records are tenant-scoped.
    match /companies/{companyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner_uid == request.auth.uid;
      allow update: if signedIn() && (resource.data.owner_uid == request.auth.uid || sameCompany(companyId));
      allow delete: if false;
    }

    // Workforce background queue jobs
    match /workforce_jobs/{jobId} {
      allow read, create, update, delete: if signedIn();
    }

    // Scheduled workflows
    match /scheduled_workflows/{workflowId} {
      allow read, create, update, delete: if signedIn();
    }

    // Payments and subscription orders
    match /payments/{paymentId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;
    }

    // All tenant subcollections under /tenants/{companyId}/
    match /tenants/{companyId}/{collection}/{documentId} {
      allow read, create, update, delete: if signedIn();
    }

    // Legacy/nested tenant subcollections under /companies/{companyId}/
    match /companies/{companyId}/{collection}/{documentId} {
      allow read, create, update, delete: if signedIn();
    }
  }
}
